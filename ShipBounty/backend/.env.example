APP_NAME=ShipBounty API
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/github_bounty_dispenser
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
GITHUB_APP_ID=replace-with-your-app-id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
-----END RSA PRIVATE KEY-----"
GITHUB_OAUTH_CLIENT_ID=replace-with-your-github-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-your-github-app-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:3000
# Comma-separated key-id:secret keyrings. Put the newest key first.
AUTH_JWT_KEYS=v1:replace-with-at-least-32-random-bytes
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=v1:replace-with-a-fernet-key
AUTH_SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=gbd_session
# Production subdomains can share a session with a parent domain such as .example.com
SESSION_COOKIE_DOMAIN=
# Non-production showcase login. Keep false outside an isolated demo environment.
DEMO_MODE=false
# Use at least 16 random characters. Never reuse a production secret.
DEMO_ACCESS_KEY=
# Comma-separated GitHub numeric user IDs allowed to view cross-tenant operations.
PLATFORM_ADMIN_GITHUB_IDS=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CELERY_MAX_RETRIES=5
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270
OUTBOX_DISPATCH_BATCH_SIZE=100
NOTIFICATION_MAX_RETRIES=5
# Leave SMTP_HOST empty to keep email deliveries in an observable retry state.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Payouts fail closed until both flags are deliberately changed.
PAYOUTS_ENABLED=false
PAYOUTS_EMERGENCY_PAUSED=true
PAYOUTS_ALLOW_MAINNET=false
# Development-only legacy escape hatch. Production rejects true.
ALLOW_MANUAL_PAYOUT_STATE=false
PAYOUT_SUBMISSION_RECOVERY_MAX_ATTEMPTS=5
# HTTPS endpoint for a custody service that simulates, proposes/signs through
# a multisig, broadcasts, and reports transaction status. Never put keys here.
PAYOUT_PROVIDER_BASE_URL=
PAYOUT_PROVIDER_API_TOKEN=
PAYOUT_PROVIDER_TIMEOUT_SECONDS=20
PAYOUT_RECONCILIATION_INTERVAL_SECONDS=30
# Verified Base Sepolia test configuration. Override only after re-verification.
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_EXPLORER_URL=https://sepolia-explorer.base.org
ANALYSIS_VERSION=v1
EXTERNAL_ANALYZERS_ENABLED=false
ANALYZER_CONTAINER_RUNTIME=docker
# JSON mapping tool name to an immutable image digest, for example:
# {"ruff":"registry.example/analyzers/ruff@sha256:..."}
ANALYZER_IMAGES_JSON={}
ANALYZER_TIMEOUT_SECONDS=120
ANALYZER_MAX_OUTPUT_BYTES=1048576
AI_REVIEW_PROMPT_VERSION=ai-review-v1
# Supported values: openai, gemini
AI_REVIEW_PROVIDER=gemini
# Atomic Redis-backed provider-call limit per UTC day. Set 0 to disable calls.
AI_REVIEW_DAILY_LIMIT=50
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
# Required only when advisory AI is enabled. Pin a model/snapshot per policy.
OPENAI_AI_REVIEW_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest
AI_REVIEW_TIMEOUT_SECONDS=90
# Google AI Studio / Gemini. Free-tier inputs must not contain confidential code.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_AI_REVIEW_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_OUTPUT_TOKENS=2500
ALLOW_MANUAL_AI_REVIEW_STATE=false
